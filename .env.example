# ==========================================
# NEXUS AI — Environment Configuration
# ==========================================

# Application
PROJECT_NAME="NEXUS AI - Topic-Augmented Knowledge Graph Backend"
ENVIRONMENT="development"
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_STR="/api/v1"

# CORS Allowed Origins (comma separated or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# Storage & Upload Limits
UPLOAD_DIR="backend/uploads"
STORAGE_DIR="backend/storage"
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=120
MIN_CHUNK_SIZE=50

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY="backend/storage/chroma"
CHROMA_COLLECTION_PREFIX="nexus"

# Knowledge Graph (Neo4j)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="nexuspassword"
NEO4J_DATABASE="neo4j"
USE_IN_MEMORY_GRAPH_FALLBACK=true

# Embedding Provider
# Options: "chroma_default", "ollama", "openai", "sentence_transformers"
EMBEDDING_PROVIDER="chroma_default"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# LLM Provider
# Options: "rule_based" (offline deterministic), "ollama", "openai"
LLM_PROVIDER="rule_based"
LLM_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3.2"
LLM_API_KEY=""
LLM_TIMEOUT_SECONDS=45.0
